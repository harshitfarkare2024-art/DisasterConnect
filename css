*{
  margin: 0;
  padding: 0;
}
body{
  background-color: gray;
}
#header{
  background-color:black;
  height:45px;
}
#header h1{
  font-size: 25px;
  padding-top: 8px;
  padding-left: 15px;
  color: white;
  position: relative;
}
#login_card{
  position: absolute;
  height: 250px;
  width: 300px;
  background-color: rgb(255, 255, 255);
  border-radius: 20px;
  margin: 150px;
}
#contact{
  height: 30px;
  width: 200px;
  border-radius: 10px;
  padding-left: 12px;
}
#pass{
  height: 30px;
  width: 200px;
  border-radius: 10px;
  padding-left: 12px;
  margin-top: 3px;
}
#form{
  position:absolute;
  margin:35px;
  margin-top: 60px;
}